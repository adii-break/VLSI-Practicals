• Verilog Code For JK Flip Flop :-
`timescale 1ns / 1ps
module jk_ff(
 input wire clk,
 input wire rst_n,
 input wire j,
 input wire k,
 output reg q,
 output wire q_bar
);
always @(posedge clk or posedge rst_n) begin
 if (rst_n) begin
 q <= 1'b0;
 end else begin
 case ({j, k})
 2'b00: q <= q;
 2'b01: q <= 1'b0;
 2'b10: q <= 1'b1;
 2'b11: q <= ~q;
 endcase
 end
end
assign q_bar = ~q;
endmodule

