`timescale 1ns / 1ps
module tb_up_down_counter_3bit;
reg clk;
reg rst_n;
reg up_down;
wire [2:0] count;
// Instantiate UUT
up_down_counter_3bit uut (
 .clk(clk),
 .rst_n(rst_n),
 .up_down(up_down),
 .count(count)
);
// Generate 10ns clock
always #5 clk = ~clk;
initial begin
 // Initialize signals
 clk = 0;
 rst_n = 0;
 up_down = 1;
 // Apply reset
 #12 rst_n = 1;
 // Count UP: 000 to 111 and wrap to 000
 up_down = 1;
 #80;
 // Count DOWN: 000 to 111 (down-count wraps)
 up_down = 0;
 #80;
 // Stop simulation
 $finish;
end
endmodule

