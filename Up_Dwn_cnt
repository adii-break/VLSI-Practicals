• Code for hardware :
module up_down_counter_3bit (
 input wire clk, // Clock signal
 input wire rst_n, // Asynchronous active-low reset
 input wire up_down,
 // 1: Count Up, 0: Count Down
 output reg [2:0] count // 3-bit counter output
);
reg [25:0] divider_counter;
reg clk_1hz;
always @(posedge clk or negedge rst_n) begin
 if (!rst_n) begin
 divider_counter <= 26'd0;
 clk_1hz <= 1'b0;
 end
 else begin
 if (divider_counter == 26'd49_999_999) begin
 divider_counter <= 26'd0;
 clk_1hz <= ~clk_1hz;
 end
 else begin
 divider_counter <= divider_counter + 1'b1;
 end
 end
end
always @(posedge clk_1hz or negedge rst_n) begin
 if (!rst_n) begin
 count <= 3'b000;
 end
 else begin
 if (up_down)
 count <= count + 1'b1; // Count Up
 else
 count <= count - 1'b1; // Count Down
 end
end
endmodule

