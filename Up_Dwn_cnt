• Binary Counter :
`timescale 1ns / 1ps
module binary_counter(
 input clk,
 input reset,
 output reg [3:0] count
);
always @(posedge clk or posedge reset) begin
 if (reset)
 count <= 4'b0000;
 else
 count <= count + 1'b1;
end
endmodule

