1)	4:1 MUX using Behavioural Modeling

module FourToOne_B(
    input I0,
    input I1,
    input I2,
    input I3,
    input [1:0] S,
    output reg Y
);

always @(*)
begin
    if (S == 2'b00)
        Y = I0;
    else if (S == 2'b01)
        Y = I1;
    else if (S == 2'b10)
        Y = I2;
    else
        Y = I3;
end

endmodule

2)	4:1 MUX using Gate-Level Modeling

module FourToOne_G(
    input I0,
    input I1,
    input I2,
    input I3,
    input S0,
    input S1,
    output Y
);

wire S0_bar, S1_bar;
wire W0, W1, W2, W3;

// Inverters
not (S0_bar, S0);
not (S1_bar, S1);

// AND gates
and (W0, I0, S1_bar, S0_bar);
and (W1, I1, S1_bar, S0);
and (W2, I2, S1, S0_bar);
and (W3, I3, S1, S0);

// OR gate
or (Y, W0, W1, W2, W3);

endmodule

3)	4:1 MUX using Hierarchical Modeling
// 2:1 MUX
module mux2to1(
    input I0,
    input I1,
    input S,
    output Y
);

assign Y = S ? I1 : I0;

endmodule


// 4:1 MUX using 2:1 MUX modules
module mux4to1(
    input I0,
    input I1,
    input I2,
    input I3,
    input S0,
    input S1,
    output Y
);

wire W1, W2;

mux2to1 M1 (.I0(I0), .I1(I1), .S(S0), .Y(W1));
mux2to1 M2 (.I0(I2), .I1(I3), .S(S0), .Y(W2));

mux2to1 M3 (.I0(W1), .I1(W2), .S(S1), .Y(Y));

endmodule

4)	4:1 MUX using Hierarchical Modeling
module FourToOne(
    input I0,
    input I1,
    input I2,
    input I3,
    input [1:0]S,
    output Y
    );
    assign Y = S[1] ? (S[0] ? I3:I2) : (S[0] ? I1:I0);
endmodule

