Siso_4bit.v :
module siso_4bit (
    input clk_1mhz,
    input rst,
    input s_in,
    output s_out
);

    reg [3:0] q;
    reg clk_1hz;
    reg [25:0] counter;

    // Clock divider: 1 MHz to 1 Hz
    always @(posedge clk_1mhz or negedge rst) begin
        if (!rst) begin
            counter <= 26'b0;
            clk_1hz <= 0;
        end
        else if (counter == 26'd49_999_999) begin
            counter <= 26'b0;
            clk_1hz <= ~clk_1hz;
        end
        else begin
            counter <= counter + 1'b1;
        end
    end

    // Initialize shift register
    initial q = 4'b0;

    // 4-bit SISO shift register
    always @(posedge clk_1hz or negedge rst) begin
        if (!rst)
            q = 4'b0;
        else begin
            q[3:1] = q[2:0];
            q[0] = s_in;
        end
    end

    // Serial output
    assign s_out = q[3];

endmodule

